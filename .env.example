# OOM Diagnostic Bot Configuration
# Copy this file to .env and fill in your actual values

# ===========================================
# REQUIRED: Slack Configuration
# ===========================================

# Bot User OAuth Token (starts with xoxb-)
# Get this from: Slack App → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=

# App-Level Token (starts with xapp-)
# Get this from: Slack App → Basic Information → App-Level Tokens
SLACK_APP_TOKEN=

# Signing Secret
# Get this from: Slack App → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=

# Slack channel IDs to monitor (comma-separated)
# Get channel IDs by right-clicking on channel → View channel details
# Channel IDs start with 'C' followed by alphanumeric characters
MONITORED_CHANNELS=

# ===========================================
# OPTIONAL: OpenShift/Kubernetes Configuration
# ===========================================

# OpenShift API server URL
# Example: https://api.your-cluster.example.com:6443
OPENSHIFT_API_URL=

# Service account token for OpenShift API access
# Create with: oc create serviceaccount oom-bot
# Get token with: oc create token oom-bot
OPENSHIFT_TOKEN=

# ===========================================
# OPTIONAL: Prometheus Configuration
# ===========================================

# Prometheus server URL
# Example: http://prometheus.monitoring.svc.cluster.local:9090
PROMETHEUS_URL=

# Bearer token for Prometheus authentication (if required)
PROMETHEUS_TOKEN=

# ===========================================
# OPTIONAL: AWS CloudWatch Configuration
# ===========================================

# AWS access key ID
AWS_ACCESS_KEY_ID=

# AWS secret access key
AWS_SECRET_ACCESS_KEY=

# AWS region
AWS_DEFAULT_REGION=us-east-1

# ===========================================
# Bot Behavior Configuration
# ===========================================

# Keywords to detect OOM incidents (comma-separated)
OOM_KEYWORDS=OOMKilled,memory limit exceeded,killed due to memory

# Enable debug mode for verbose logging
DEBUG_MODE=false

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Request timeout for external API calls (seconds)
REQUEST_TIMEOUT=30

# Maximum concurrent requests to external APIs
MAX_CONCURRENT_REQUESTS=10

# ===========================================
# OPTIONAL: Monitoring Configuration
# ===========================================

# Grafana admin password (for docker-compose monitoring stack)
GRAFANA_PASSWORD=admin

# ===========================================
# OPTIONAL: Docker Build Configuration
# ===========================================

# Build metadata (used in docker-compose)
BUILD_DATE=
VERSION=latest
VCS_REF=

# ===========================================
# Configuration Examples
# ===========================================

# Example for development:
# DEBUG_MODE=true
# LOG_LEVEL=DEBUG
# MONITORED_CHANNELS=C1234567890

# Example for production:
# DEBUG_MODE=false
# LOG_LEVEL=INFO
# REQUEST_TIMEOUT=30
# MONITORED_CHANNELS=C1234567890,C0987654321,C5555555555

# Example with all data sources:
# OPENSHIFT_API_URL=https://api.prod-cluster.example.com:6443
# OPENSHIFT_TOKEN=eyJhbGciOiJSUzI1NiIsImtpZCI6...
# PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090
# PROMETHEUS_TOKEN=Bearer_token_here
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_DEFAULT_REGION=us-west-2

# ===========================================
# Security Notes
# ===========================================

# 1. Never commit this file with real values to version control
# 2. Use least-privilege access for all service accounts and tokens
# 3. Regularly rotate tokens and access keys
# 4. Monitor bot activity and API usage
# 5. Consider using secrets management systems for production deployments

# ===========================================
# Troubleshooting
# ===========================================

# If the bot isn't responding to messages:
# 1. Check that MONITORED_CHANNELS contains correct channel IDs
# 2. Verify the bot is invited to those channels
# 3. Ensure SLACK_BOT_TOKEN has required permissions (chat:write, channels:history)
# 4. Check logs with DEBUG_MODE=true

# If external data collection fails:
# 1. Verify network connectivity to API endpoints
# 2. Check authentication tokens and permissions
# 3. Increase REQUEST_TIMEOUT if APIs are slow
# 4. Review API endpoint URLs and formats
